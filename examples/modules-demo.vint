// VintLang Module Features Demo
// This file demonstrates all supported modules

// ============================================
// ARGPARSE MODULE
// ============================================
import argparse

let parser = argparse.newParser("demo", "Module demonstration app")
argparse.addArgument(parser, "name", {
    "description": "Your name",
    "required": true
})
argparse.addFlag(parser, "--verbose", {
    "description": "Enable verbose output",
    "shorthand": "-v"
})

// ============================================
// CLI MODULE
// ============================================
import cli

println("=== CLI Module Demo ===")
let userInput = cli.prompt("Enter your age: ")
println("You entered:", userInput)

// ============================================
// UUID MODULE
// ============================================
import uuid

println("\n=== UUID Module Demo ===")
let id1 = uuid.new()
let id2 = uuid.new()
println("Generated UUID 1:", id1)
println("Generated UUID 2:", id2)

// ============================================
// KV (Key-Value) MODULE
// ============================================
import kv

println("\n=== KV Module Demo ===")
kv.set("username", "johndoe")
kv.set("email", "john@example.com")
kv.set("age", 30)

let username = kv.get("username")
let email = kv.get("email")
let age = kv.get("age")

println("Username:", username)
println("Email:", email)
println("Age:", age)

// Check if key exists
if (kv.has("username")) {
    println("Key 'username' exists")
}

// Delete a key
kv.delete("age")
println("Age after delete:", kv.get("age"))

// ============================================
// RANDOM MODULE
// ============================================
import random

println("\n=== Random Module Demo ===")
let randomInt = random.int(1, 100)
let randomFloat = random.float(0.0, 1.0)

println("Random integer (1-100):", randomInt)
println("Random float (0-1):", randomFloat)

